# .env.example - Configuration template
# Copy this to .env.local for development and fill in the values

# Edna AI Assistant (Google Gemini)
# --------------------------------------------------
# REQUIRED in production. Create a key at: https://aistudio.google.com/apikey
# Keep it server-side only (never prefix with NEXT_PUBLIC_).
GEMINI_API_KEY=your-gemini-api-key

# --- Optional tuning (defaults shown) ---
# Kill switch: set to "false" to turn Edna off without redeploying code.
# Rate-limit storage — REQUIRED on Vercel (serverless instances don't share memory).
# Easiest: Vercel dashboard > Storage > Marketplace > Upstash Redis > connect to this project;
# it injects these variables automatically (KV_REST_API_URL / KV_REST_API_TOKEN also work).
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# EDNA_ENABLED=true
# Primary model, and the cheaper one used automatically if the primary is overloaded.
# EDNA_MODEL=gemini-3.5-flash
# EDNA_FALLBACK_MODEL=gemini-3.5-flash-lite
# Usage controls (per visitor = logged-in user, otherwise IP address):
# EDNA_RATE_LIMIT_PER_MINUTE=6
# EDNA_RATE_LIMIT_PER_DAY=60
# Hard daily cap on total Edna messages across ALL visitors (cost protection).
# EDNA_DAILY_GLOBAL_LIMIT=3000
# EDNA_THINKING_LEVEL=minimal
# EDNA_MAX_INPUT_CHARS=1000
# EDNA_MAX_HISTORY_MESSAGES=12
# EDNA_MAX_OUTPUT_TOKENS=700
# EDNA_TIMEOUT_MS=25000

# NextAuth Configuration
# --------------------------------------------------
# Generate a secure secret with: openssl rand -base64 32
# or use: npm auth secrete to generate .env.local then copy the value and replace with this AUTH_SECRET value
AUTH_SECRET=your-secret-key-here

# Set to your development URL
NEXTAUTH_URL=http://localhost:3000

# Development User Credentials
# --------------------------------------------------
# Default admin user for development (remove in production)
DEFAULT_USER_EMAIL=admin@admin.com # you can modify this with your email

# To generate a password hash:
# 1. Install bcrypt: npm install bcryptjs
# 2. Run in Node console:
#    const bcrypt = require('bcryptjs');
#    console.log(bcrypt.hashSync('yourpassword', 12));
# 
# IMPORTANT: Escape $ signs with backslashes in .env files:
# Example: \$2a\$12\$NhL4x...
DEFAULT_USER_PASSWORD=\$2a\$12\$your-hashed-password-here


# Database Configuration (when implemented)
# --------------------------------------------------
# DATABASE_URL=your-database-connection-string
# DB_HOST=localhost
# DB_USER=user
# DB_PASSWORD=password
# DB_NAME=yourdb


## CLOUDINARY CONFIGURATION (for image uploads)
# # --------------------------------------------------
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret